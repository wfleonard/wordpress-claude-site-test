{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#9d2e32" },
				{ "slug": "primary-dark", "name": "Primary dark", "color": "#7a2226" },
				{ "slug": "primary-light", "name": "Primary light", "color": "#f6e9ea" },
				{ "slug": "accent", "name": "Saxon gray", "color": "#bbbdc0" },
				{ "slug": "ink", "name": "Ink", "color": "#222324" },
				{ "slug": "surface-alt", "name": "Light gray", "color": "#f5f5f6" },
				{ "slug": "white", "name": "White", "color": "#ffffff" }
			]
		},
		"layout": {
			"contentSize": "46rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "1.45rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "1.9rem" }
			]
		}
	}
}
